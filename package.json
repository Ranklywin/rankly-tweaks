{
  "name": "rankly-tweaks",
  "productName": "Rankly Tweaks",
  "version": "1.1.0",
  "description": "Windows gaming controls for graphics, CPU, networking, input, and background activity.",
  "author": "Rankly",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "desktop": "tauri dev",
    "build": "tsc -b && vite build",
    "test": "node --test tests/*.test.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "catalog": "node scripts/export-catalog.mjs",
    "package": "npm run check:release && node scripts/package.mjs",
    "notices:update": "node scripts/generate-notices.mjs",
    "check:release": "node scripts/check-release.mjs && node scripts/export-catalog.mjs --check && node scripts/generate-notices.mjs --check",
    "verify:package": "node scripts/verify-package.mjs",
    "checksums": "node scripts/checksums.mjs",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@fontsource/poppins": "5.2.7",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/cli": "2.12.4",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.14.1",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "lucide-react": "0.562.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ranklywin/rankly-tweaks.git"
  },
  "homepage": "https://github.com/ranklywin/rankly-tweaks#readme",
  "bugs": {
    "url": "https://github.com/ranklywin/rankly-tweaks/issues"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
